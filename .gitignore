# --- Python build and bytecode -------------------------------------------
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments -------------------------------------------------
# uv.lock is deliberately NOT ignored: this is an application, and the lock
# file is what makes an install reproducible.
.venv/
venv/
env/

# --- Test and tooling caches ----------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
lab/

# --- Secrets and SSH material ---------------------------------------------
# This project handles SSH. A private key or a known_hosts file has no business
# in the repository, so refuse them by name rather than trusting care alone.
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
known_hosts
known_hosts.old
.ssher/
config.local.toml
.env
.env.*

# --- Local scratch --------------------------------------------------------
# Somewhere to put a throwaway script or a downloaded log while working,
# without it turning up in `git status`.
scratch/
tmp/
*.log
*.bak
*.orig
*.rej

# --- Editors --------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.codebuddy/

# --- Operating system -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
